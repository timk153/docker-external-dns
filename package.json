{
  "name": "docker-compose-external-dns",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "engines": {
    "node": ">=24.9.0",
    "yarn": ">=1.22.19 < 1.23.0"
  },
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug 0.0.0.0:9229 --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\"",
    "test": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --reporters=default",
    "test:watch": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --reporters=default --watch",
    "test:cov": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --reporters=default --coverage --coverageReporters=text",
    "test:debug": "node --experimental-vm-modules --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --reporters=default --runInBand",
    "test:e2e": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --config ./test/jest-e2e.json --runInBand --reporters=default",
    "test:e2e:watch": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --config ./test/jest-e2e.json --runInBand --reporters=default --watch",
    "test:ci": "(jest --ci --collectCoverage || true)",
    "test:e2e:ci": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --ci --runInBand --config ./test/jest-e2e.json || exit 0"
  },
  "dependencies": {
    "@nestjs/common": "^12.0.0",
    "@nestjs/config": "^12.0.0",
    "@nestjs/core": "^12.0.0",
    "@nestjs/mapped-types": "^12.0.0",
    "@nestjs/platform-express": "^12.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "cloudflare": "^3.5.0",
    "dockerode": "^5.0.0",
    "joi": "^18.0.0",
    "logger-decorator": "^1.8.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@golevelup/ts-jest": "^0.7.0",
    "@nestjs/cli": "^12.0.0",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.0",
    "@types/dockerode": "^4.0.1",
    "@types/express": "^5.0.2",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.14.9",
    "@types/supertest": "^6.0.3",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.42.0",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-config-airbnb-typescript": "^18.0.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-prettier": "^5.4.0",
    "jest": "^30.4.0",
    "jest-each": "^29.7.0",
    "jest-junit": "^17.0.0",
    "prettier": "^3.5.3",
    "source-map-support": "^0.5.21",
    "supertest": "^7.1.1",
    "testcontainers": "^12.0.0",
    "ts-jest": "^29.4.0",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^6"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../reports",
    "coverageReporters": [
      [
        "cobertura",
        {
          "file": "cobertura-coverage.xml"
        }
      ]
    ],
    "testEnvironment": "node",
    "reporters": [
      [
        "jest-junit",
        {
          "suiteName": "docker-compose-external-dns tests",
          "outputDirectory": "reports",
          "outputName": "test-results-junit.xml"
        }
      ]
    ]
  }
}
